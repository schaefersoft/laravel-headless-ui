{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "laravel-headless-ui",
  "description": "A simple to use, completely unstyled laravel blade ui package.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "format": "prettier --write resources .github \"*.{ts,json}\"",
    "format:check": "prettier --check resources .github \"*.{ts,json}\""
  },
  "private": true,
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
